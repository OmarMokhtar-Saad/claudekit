{
  "autoCompactWindow": 100000,
  "skillListingBudgetFraction": 0.03,
  "skillListingMaxDescChars": 150,
  "permissions": {
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "Glob",
      "TodoWrite",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "ListAgents",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "ShareOnboardingGuide",
      "Workflow"
    ]
  },
  "skillOverrides": {
    "prompt-injection-defense": "on",
    "java-review-checklist": "off",
    "kotlin-review-checklist": "off",
    "typescript-review-checklist": "off",
    "accessibility-standards": "off",
    "api-design-patterns": "off",
    "blueprint": "off",
    "brainstorming": "off",
    "clarify": "off",
    "clean-architecture": "off",
    "code-explanation": "off",
    "codebase-mapping": "off",
    "codebase-onboarding": "off",
    "command-flags": "off",
    "constitution": "off",
    "containerization-patterns": "off",
    "context-budget": "off",
    "context-keeper": "off",
    "continuous-learning": "off",
    "council": "off",
    "cross-tool-collaboration": "off",
    "deep-research": "off",
    "differential-security-review": "off",
    "dispatching-parallel-agents": "off",
    "error-handling": "off",
    "eval-harness": "off",
    "executing-plans": "off",
    "finishing-a-development-branch": "off",
    "hook-profiling": "off",
    "hookify": "off",
    "i18n-patterns": "off",
    "incident-response": "off",
    "insecure-defaults": "off",
    "mcp-integration": "off",
    "monitoring-observability": "off",
    "opensource-pipeline": "off",
    "performance-guidelines": "off",
    "project-adaptation": "off",
    "prompt-evaluation": "off",
    "property-based-testing": "off",
    "prp-plan": "off",
    "python-review-checklist": "off",
    "receiving-code-review": "off",
    "refactoring-patterns": "off",
    "release-integrity": "off",
    "request-shaping": "off",
    "requesting-code-review": "off",
    "safe-command-approval": "off",
    "search-first": "off",
    "spec-driven-development": "off",
    "static-analysis-integration": "off",
    "subagent-driven-development": "off",
    "token-budget-advisor": "off",
    "token-optimization": "off",
    "usage-monitoring": "off",
    "using-git-worktrees": "off",
    "verification-gap-lens": "off",
    "whitebox-invariant-testing": "off",
    "writing-skills": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/dispatch.sh\" PreToolUse'"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/delegate-nudge.py\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/post-tool-use.sh\"'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/output_filter.py\"'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/batch-reads-nudge.py\"'"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Write|Edit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/context-budget-gate.py\" --advise'"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/web-park.py\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; USER_INPUT=$(cat); PLAN_REF=$(echo \"$USER_INPUT\" | grep -ioE \"(plan|create plan|new plan)\\s+[a-zA-Z0-9_-]+\" | head -1 | sed \"s/^[^ ]* //\"); if [ -n \"$PLAN_REF\" ]; then bash \"$ROOT/.claude/hooks/pre-plan.sh\" \"$PLAN_REF\"; fi'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/injection-scan-gate.sh\"'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/route-hint.py\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/reflection-gate.py\" --event SessionStart'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/session-start.sh\"'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/compaction-cadence.py\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/compaction-cadence.py\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/cost-tracker.sh\" &'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/desktop-notify.sh\" &'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; bash \"$ROOT/.claude/hooks/format-typecheck.sh\" &'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/delegation-report.py\"'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; python3 \"$ROOT/.claude/hooks/reflection-gate.py\" --event PostToolUseFailure'"
          }
        ]
      }
    ]
  }
}
