# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Node
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ClaudeKit
backups/
*.log
.claude-core.lock
.claude/.managed/
.claude/hooks/compact-counter.txt
# Review records: verdict + a full snapshot of each approved ops.json. Local drift-gate
# state; duplicates large configs, so never shipped.
.claude/reports/reviews/

# Local, per-developer Claude Code overrides (never shipped)
.claude/settings.local.json

# Per-session lock files (concurrent-session detection; runtime state)
.claude/locks/

# Reflection ledger: sanitized failure fingerprints, session HMAC tokens and
# post-compaction carry-over notes, plus the project-local receipt inbox
# (inbox-<session>.json). The ledger itself is written OUTSIDE the repo (OS temp dir)
# so it survives compaction and can never be committed; this rule is belt-and-braces
# for a project that points CLAUDEKIT_REFLECTION_DIR at the working tree.
.claude/reflection/

# Worktree-per-agent runtime state: linked worktrees + the manager's registry
# (machine-local paths; never shipped — install.sh copies .claude/ wholesale)
.worktrees/
.claude/state/

.coverage

# xpipe per-stage headless logs (runtime state)
.claude/reports/xpipe/

# pytest fixture sandbox for tests/test_silent_failure_lint.py
.tmp-test-fixtures/
# Enforcement runtime state: typed event log + spilled tool output (session-scoped).
# Runtime state is never a source artifact -- re-derive, never cite.
.claude/runtime/
