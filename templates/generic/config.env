# Deliberately empty. A no-op print command as a placeholder exits 0, which made
# pre-push.sh report "Tests: PASSED" for a project that has no tests configured.
# Empty means the hooks skip the step and say so. Set real commands in
# .claude/hooks/config.json (or add a templates/<language>/config.env).
BUILD_CMD=""
TEST_CMD=""
LINT_CMD=""
COVERAGE_CMD=""
FRAMEWORK="N/A"
BUILD_SYSTEM="N/A"
TEST_FRAMEWORK="N/A"
EXAMPLE_FILE="src/main"
